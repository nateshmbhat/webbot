---------- server.py ----------

from fastapi import FastAPI, WebSocket, Request from fastapi.responses import HTMLResponse from pydantic import BaseModel from typing import List import predictor import asyncio import uvicorn import time

app = FastAPI()

in-memory candle store (keep recent N candles)

CANDLES: List[dict] = [] MAX_CANDLES = 200

clients = set()

class Candle(BaseModel): timestamp: float  # epoch seconds of candle close open: float high: float low: float close: float volume: float = 0.0

@app.post('/ingest') async def ingest(c: Candle): global CANDLES CANDLES.append(c.dict()) if len(CANDLES) > MAX_CANDLES: CANDLES = CANDLES[-MAX_CANDLES:] # run prediction asynchronously pred = predictor.predict_next(CANDLES) payload = { 'prediction': pred, 'timestamp': time.time(), 'last_candle': CANDLES[-1] } await broadcast(payload) return {'ok': True, 'prediction': pred}

@app.get('/candles') async def get_candles(): return {'candles': CANDLES}

@app.websocket('/ws') async def websocket_endpoint(ws: WebSocket): await ws.accept() clients.add(ws) try: while True: data = await ws.receive_text() # echo or ignore (clients usually only receive) except Exception: pass finally: clients.remove(ws)

async def broadcast(payload: dict): remove = [] for ws in clients: try: await ws.send_json(payload) except Exception: remove.append(ws) for r in remove: clients.remove(r)

if name == 'main': uvicorn.run('server:app', host='0.0.0.0', port=8000, reload=True)

---------- predictor.py ----------

Simple rule-based predictor using EMA and RSI heuristics.

import numpy as np import pandas as pd

def compute_ema(series, span): return series.ewm(span=span, adjust=False).mean()

def compute_rsi(series, period=14): delta = series.diff() up = delta.clip(lower=0) down = -1 * delta.clip(upper=0) ma_up = up.rolling(period).mean() ma_down = down.rolling(period).mean() rs = ma_up / (ma_down + 1e-9) rsi = 100 - (100 / (1 + rs)) return rsi

def predict_next(candles): # candles: list of dict with 'open','high','low','close' if len(candles) < 20: return 'NEUTRAL'  # not enough data df = pd.DataFrame(candles) close = df['close'] ema_short = compute_ema(close, span=8) ema_long = compute_ema(close, span=21) rsi = compute_rsi(close, period=14)

last_idx = len(df)-1
ema_short_last = ema_short.iloc[last_idx]
ema_long_last = ema_long.iloc[last_idx]
rsi_last = rsi.iloc[last_idx]

# simple rules:
# bullish if short EMA > long EMA and recent candles mostly green and RSI not overbought
recent = df['close'].diff().iloc[-5:]
green_count = (recent > 0).sum()

if ema_short_last > ema_long_last and green_count >= 3 and rsi_last < 75:
    return 'BULL'
if ema_short_last < ema_long_last and green_count <= 2 and rsi_last > 25:
    return 'BEAR'
return 'NEUTRAL'

