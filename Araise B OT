def poll_and_notify(interval=1.5): last_pred = None while True: try: r = requests.get(SERVER_URL + '/candles', timeout=5) data = r.json() from predictor import predict_next pred = predict_next(data.get('candles', [])) if pred != last_pred and pred in ('BULL','BEAR'): send_telegram(f'New signal: {pred} at {time.ctime()}') last_pred = pred except Exception as e: print('poll error', e) time.sleep(interval)

