  <h2>RealCandleBot - Live Signals</h2>
  <div id="status" class="card">Connecting...</div>
  <div id="signal" class="card">No signal yet</div>
  <script>
    const WS = new WebSocket((location.protocol === 'https:' ? 'wss://' : 'ws://') + location.host + '/ws');
    const status = document.getElementById('status');
    const signal = document.getElementById('signal');
    WS.onopen = () => { status.innerText = 'Connected to server'; }
    WS.onmessage = (ev) => {
       const data = JSON.parse(ev.data);
       signal.innerHTML = '<b>Prediction:</b> ' + data.prediction + '<br><small>' + new Date(data.timestamp*1000).toLocaleString() + '</small>';
       signal.className = 'card ' + (data.prediction === 'BULL' ? 'bull' : data.prediction === 'BEAR' ? 'bear' : '');
    }
    WS.onclose = () => { status.innerText = 'Disconnected'; }
  </script>
