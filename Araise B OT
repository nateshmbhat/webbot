---------- userscript.js ----------

// Userscript (Tampermonkey / Violentmonkey) to read last closed candle from chart DOM // This is a template — sites differ, so you will need to adapt selectors for Quotex / Pocket Option.

// ==UserScript== // @name         Candle Ingestor for Trading Sites // @namespace    http://tampermonkey.net/ // @version      0.1 // @description  Scrape last candle data and POST to server // @match        ://.qux*/* // @match        ://.pocketoption*/* // @grant        none // ==/UserScript==

(function() { 'use strict';

// Set this to your server public URL (e.g., from ngrok)
const SERVER_URL = 'https://REPLACE_WITH_YOUR_SERVER.ngrok.io';

// Adjust depending on how chart data is accessible
function extractCandleFromDOM() {
    // Example: if the site exposes window.chart or similar
    try {
        // Attempt common places
        if (window.tvWidget && window.tvWidget.activeChart) {
            const series = window.tvWidget.activeChart().data();
            const last = series[series.length-1];
            return {timestamp: Math.floor(last.time/1000), open: last.open, high: last.high, low: last.low, close: last.close, volume: last.volume || 0};
        }
    } catch(e){}

    // Fallback: try to read textual DOM elements (site-specific) — user will need to customize
    return null;
}

let lastTs = 0;
setInterval(async () => {
    const c = extractCandleFromDOM();
    if (!c) return;
    if (c.timestamp === lastTs) return; // already sent that candle
    lastTs = c.timestamp;
    try {
        await fetch(SERVER_URL + '/ingest', {
            method: 'POST',
            headers: {'Content-Type':'application/json'},
            body: JSON.stringify(c)
        });
        console.log('sent candle', c);
    } catch (e) {
        console.error('send error', e);
    }
}, 900); // check every 900ms

})();

